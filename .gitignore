# Ignorar diretórios de dados locais (preservando apenas a estrutura de pastas via .gitkeep)
data/processed/*
!data/processed/.gitkeep
data/results/*
!data/results/.gitkeep
data/raw/*
!data/raw/.gitkeep

# Ignorar completamente a pasta source (legado histórico local não publicado no git)
source/
audit/
# Caches do Python e arquivos temporários do editor
__pycache__/
*.pyc
*~
*.bak
*.tmp

# Arquivos pesados de manufatura (g-code)
*.gcode
*.md